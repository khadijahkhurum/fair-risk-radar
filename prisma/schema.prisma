generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Compliance-as-code control catalog, mirrored from controls/catalog.yaml.
model Control {
  id          String   @id // slug from catalog.yaml, e.g. "mfa-enforcement"
  name        String
  description String
  category    String
  nistCsf     String
  iso27001    String
  soc2        String
  pciDss      String
  euAiAct     String // "N/A" where a generic control has no genuine AI-Act hook
  owaspLlm    String // "N/A" where a generic control has no genuine OWASP LLM hook
  awsConfigRule String?
  coverage    ControlCoverage[]
  evidence    Evidence[]
  createdAt   DateTime @updatedAt @default(now())
}

// Supporting evidence a visitor attaches to a control — a CSV export (access
// review, patch report) or a text note. Parsed server-side on upload; the
// parsed rows and raw text are stored so the evidence viewer can render them
// without re-parsing. Additive only (nothing here is ever overwritten), so
// unlike the control-catalog upload this is safe to persist in a shared demo.
model Evidence {
  id          String   @id @default(cuid())
  control     Control  @relation(fields: [controlId], references: [id])
  controlId   String
  filename    String
  contentType String // "csv" | "text"
  sizeBytes   Int
  summary     String // one-line human-readable summary, e.g. "CSV, 42 rows"
  parsedRows  Json? // for CSV: array of row objects, capped at 200 rows
  rawText     String // full text content, capped at ~200KB by the upload route

  uploadedAt  DateTime @default(now())

  @@index([controlId, uploadedAt])
}

// Coverage % is provenance-tagged: a number always says where it came from.
enum CoverageSource {
  MANUAL
  AWS_CONFIG
  DEMO
}

model ControlCoverage {
  id          String         @id @default(cuid())
  control     Control        @relation(fields: [controlId], references: [id])
  controlId   String
  coveragePct Float // 0-100
  source      CoverageSource
  recordedAt  DateTime       @default(now())

  @@index([controlId, recordedAt])
}

// Industry loss-profile scenarios (IBM 2025-calibrated), seeded from scenarios.ts.
model Scenario {
  id                String   @id // slug, e.g. "financial-services"
  name              String
  industry          String
  tefLambda         Float // Threat Event Frequency: mean events/year (Poisson)
  vulnerability     Float // probability a threat event becomes a loss event, 0-1
  // Full FAIR loss magnitude: Primary Loss (certain once a loss event occurs —
  // detection/escalation, incident response, notification) plus a Secondary
  // Loss (lost business/reputational) that only materializes some fraction of
  // the time. Each is its own triangular distribution, USD.
  primaryLossMin           Float
  primaryLossMode          Float
  primaryLossMax           Float
  secondaryLossProbability Float // 0-1: P(secondary loss occurs | a loss event occurred)
  secondaryLossMin         Float
  secondaryLossMode        Float
  secondaryLossMax         Float
  sourceNote        String // what's sourced vs. modeled, shown in the UI
  assessments       RiskAssessment[]
}

// Every simulation run is written here and never overwritten — the audit trail.
model RiskAssessment {
  id               String   @id @default(cuid())
  scenario         Scenario @relation(fields: [scenarioId], references: [id])
  scenarioId       String
  threatIds        String[] @default([]) // empty = baseline scenario, no threat modifier applied
  trials           Int
  meanAle          Float // mean Annualized Loss Expectancy, USD
  p10Ale           Float
  p50Ale           Float
  p90Ale           Float
  riskTolerance    Float? // user-set $ threshold at time of run, if any
  pExceedTolerance Float? // P(annual loss > riskTolerance)
  avgControlCoveragePct Float // control posture snapshot at time of run
  createdAt        DateTime @default(now())
  linkedRisks      Risk[]

  @@index([scenarioId, createdAt])
}

enum RiskStatus {
  OPEN
  MITIGATING
  ACCEPTED
  CLOSED
}

// The actual risk register: named risks someone owns and works, distinct
// from RiskAssessment (a simulation run's raw output). Inherent ratings are
// the qualitative likelihood/impact before controls; residual is after —
// the classic before/after pair a risk committee reviews. Suggested from a
// FAIR run via /api/risks/suggest-ratings, always manually overridable.
model Risk {
  id                  String          @id @default(cuid())
  title               String
  description         String
  ownerName           String
  status              RiskStatus      @default(OPEN)
  scenarioId          String
  threatIds           String[]        @default([])
  riskTolerance       Float?
  inherentLikelihood  Int // 1-5, before controls
  inherentImpact      Int // 1-5, before controls
  residualLikelihood  Int // 1-5, after controls
  residualImpact      Int // 1-5, after controls
  latestAssessmentId  String?
  latestAssessment    RiskAssessment? @relation(fields: [latestAssessmentId], references: [id])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
}
