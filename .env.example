# --- Database (required) ---
# Any Postgres works: Neon, Supabase, Vercel Postgres, or local.
# Example (Neon): postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/fair_risk_radar?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_wMXFi5QVrZJ3@ep-small-voice-b4n9jb7p-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- AWS Config integration (optional) ---
# Leave unset to run in demo mode: /api/integrations/aws-config returns
# representative mock compliance data instead of calling AWS.
# Set all three to pull real compliance percentages from AWS Config rules
# in your account via a read-only IAM user/role (config:GetComplianceDetailsByConfigRule,
# config:DescribeComplianceByConfigRule).
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Override which AWS Config rule name feeds each control, if yours differ
# from the AWS-managed rule names used by default (see src/lib/aws-config.ts).
AWS_CONFIG_RULE_MFA="iam-user-mfa-enabled"
AWS_CONFIG_RULE_PATCH="ec2-managedinstance-patch-compliance-status"
AWS_CONFIG_RULE_KMS="cmk-backing-key-rotation-enabled"
